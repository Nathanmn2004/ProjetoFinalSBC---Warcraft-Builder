# Blizzard World of Warcraft Classic Game Data API (OAuth client credentials)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_US
# Classic Era. Do not change this without documenting the selected game version.
BLIZZARD_NAMESPACE=static-classic1x-us

MEMGRAPH_HOST=localhost
MEMGRAPH_PORT=7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Optional: the deterministic fallback works without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
